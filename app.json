{
  "expo": {
    "name": "envanterTakip",
    "slug": "envanterTakip",
    "scheme": "envantertakip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f9ff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f8f9ff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Ürün barkodu, seri numarası ve ürün fotoğraflarını çekebilmek için kamera izni gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ürün ve fatura görselleri seçebilmek için galeri erişim izni gerekiyor.",
          "cameraPermission": "Ürün ve fatura fotoğrafları çekebilmek için kamera erişim izni gerekiyor."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4648d4"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WarrantyWidget",
              "label": "Garanti Takip",
              "minWidth": "160dp",
              "minHeight": "100dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "En yakın garanti bitiş tarihini ve aktif eşya sayısını canlı gösterir.",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bae48a5a-9e08-41f5-91c2-69be86c0e923"
      }
    }
  }
}
