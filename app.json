{
  "expo": {
    "name": "envanterTakip",
    "slug": "envanterTakip",
    "scheme": "envantertakip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f9ff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f8f9ff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Ürün barkodu, seri numarası ve ürün fotoğraflarını çekebilmek için kamera izni gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ürün ve fatura görselleri seçebilmek için galeri erişim izni gerekiyor.",
          "cameraPermission": "Ürün ve fatura fotoğrafları çekebilmek için kamera erişim izni gerekiyor."
        }
      ],
      "expo-sharing"
    ]
  }
}
